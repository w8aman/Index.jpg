<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facebook</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #ffffff;
            min-height: 100vh;
        }

        /* --- PAGE 1: LOGIN PAGE --- */
        #loginPage {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 360px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .lang-selector {
            font-size: 0.85rem;
            color: #65676b;
            margin-bottom: 2.5rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .fb-logo {
            color: #0866ff;
            font-size: 4rem;
            margin-bottom: 2.5rem;
            line-height: 1;
        }

        .form-group {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 1rem;
        }

        .photo-btn {
            width: 100%;
            padding: 12px;
            border: 1px solid #0866ff;
            border-radius: 12px;
            background: #ffffff;
            color: #050505;
            font-size: 1rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            overflow: hidden;
            height: 50px;
        }

        .photo-btn img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            display: none;
        }

        .photo-btn i {
            font-size: 1.2rem;
            color: #1c1e21;
        }

        #photoUpload {
            display: none;
        }

        .password-input {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid #dddfe2;
            border-radius: 12px;
            font-size: 0.95rem;
            outline: none;
            background: #f5f6f8;
            color: #1c1e21;
        }

        .password-input:focus {
            border-color: #0866ff;
            background: #ffffff;
        }

        .login-btn {
            width: 100%;
            padding: 12px;
            background: #0866ff;
            border: none;
            border-radius: 20px;
            color: #ffffff;
            font-size: 1.05rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 4px;
        }

        .forgot-link {
            color: #0866ff;
            font-size: 0.9rem;
            font-weight: 500;
            text-decoration: none;
            margin: 1.2rem 0 2rem 0;
            display: inline-block;
        }

        .divider {
            width: 100%;
            height: 1px;
            background-color: #e4e6eb;
            margin-bottom: 2rem;
        }

        .create-btn {
            width: 100%;
            padding: 10px;
            background: transparent;
            border: 1px solid #0866ff;
            border-radius: 20px;
            color: #0866ff;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: block;
            margin-bottom: 2.5rem;
        }

        .meta-footer {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: #050505;
            font-weight: 700;
            font-size: 1.1rem;
        }

        /* --- COMMON CONTAINER FOR MAIN APP --- */
        .app-container {
            display: none;
            background: #f0f2f5;
            min-height: 100vh;
            max-width: 500px;
            margin: 0 auto;
            border-left: 1px solid #e4e6eb;
            border-right: 1px solid #e4e6eb;
            padding-bottom: 60px;
            position: relative;
        }

        /* --- PAGE 2: FACEBOOK FEED PAGE --- */
        .feed-header {
            background: #ffffff;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid #e4e6eb;
        }

        .feed-header .logo {
            color: #0866ff;
            font-size: 1.8rem;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .header-icons {
            display: flex;
            gap: 12px;
        }

        .icon-circle {
            width: 36px;
            height: 36px;
            background: #e4e6eb;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            color: #050505;
            position: relative;
            cursor: pointer;
        }

        .badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: #e41e3f;
            color: white;
            font-size: 0.7rem;
            font-weight: bold;
            padding: 2px 5px;
            border-radius: 10px;
        }

        .status-box {
            background: #ffffff;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            background: #ccc;
        }

        .status-input {
            flex: 1;
            background: #f0f2f5;
            border-radius: 20px;
            padding: 8px 15px;
            color: #65676b;
            font-size: 0.95rem;
        }

        .gallery-icon {
            color: #45bd62;
            font-size: 1.4rem;
        }

        /* Stories Section */
        .stories-container {
            background: #ffffff;
            padding: 10px;
            display: flex;
            gap: 8px;
            overflow-x: auto;
            margin-bottom: 8px;
            scrollbar-width: none;
        }

        .stories-container::-webkit-scrollbar {
            display: none;
        }

        .story-card {
            width: 110px;
            height: 190px;
            border-radius: 12px;
            position: relative;
            flex-shrink: 0;
            overflow: hidden;
            background-size: cover;
            background-position: center;
            box-shadow: 0 1px 2px rgba(0,0,0,0.2);
        }

        .create-story {
            background: #ffffff;
            border: 1px solid #e4e6eb;
            display: flex;
            flex-direction: column;
        }

        .create-story .story-img {
            height: 130px;
            width: 100%;
            object-fit: cover;
        }

        .create-story .plus-btn {
            width: 32px;
            height: 32px;
            background: #0866ff;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 3px solid white;
            margin: -16px auto 0 auto;
            z-index: 2;
            font-size: 1.1rem;
        }

        .create-story span {
            font-size: 0.75rem;
            font-weight: 600;
            text-align: center;
            margin-top: 6px;
            color: #050505;
        }

        .story-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 3px solid #0866ff;
            position: absolute;
            top: 8px;
            left: 8px;
            object-fit: cover;
        }

        .story-name {
            position: absolute;
            bottom: 8px;
            left: 8px;
            right: 8px;
            color: white;
            font-size: 0.8rem;
            font-weight: 600;
            text-shadow: 0 1px 2px rgba(0,0,0,0.8);
        }

        /* Feed Post */
        .post-card {
            background: #ffffff;
            margin-bottom: 10px;
        }

        .post-header {
            padding: 10px 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .post-author-img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .post-author-info {
            flex: 1;
        }

        .author-name {
            font-size: 0.95rem;
            font-weight: 700;
            color: #050505;
        }

        .author-name span {
            font-weight: 400;
            color: #65676b;
        }

        .post-time {
            font-size: 0.75rem;
            color: #65676b;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .follow-btn {
            color: #0866ff;
            font-weight: 600;
            font-size: 0.9rem;
            margin-left: 5px;
            text-decoration: none;
        }

        .post-options {
            color: #65676b;
            font-size: 1.1rem;
            display: flex;
            gap: 15px;
        }

        .post-content-text {
            padding: 0 15px 8px 15px;
            font-size: 0.9rem;
            color: #050505;
            line-height: 1.4;
        }

        .hashtags {
            color: #0866ff;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .post-main-image {
            width: 100%;
            display: block;
            max-height: 500px;
            object-fit: cover;
        }

        .post-actions {
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            border-top: 1px solid #e4e6eb;
            margin-top: 5px;
            color: #65676b;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .action-item {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        /* --- PAGE 3: MESSENGER INBOX PAGE --- */
        #messengerPage {
            display: none;
            background: #ffffff;
            min-height: 100vh;
        }

        .messenger-header {
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            background: #ffffff;
            z-index: 10;
        }

        .messenger-header .left-sec {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .messenger-header .title {
            font-size: 1.5rem;
            font-weight: 800;
            color: #050505;
        }

        .msg-search-bar {
            margin: 0 15px 15px 15px;
            background: #f0f2f5;
            padding: 8px 15px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #65676b;
        }

        .msg-search-bar input {
            border: none;
            background: transparent;
            outline: none;
            width: 100%;
            font-size: 0.95rem;
        }

        /* Active/Online users row */
        .online-row {
            display: flex;
            gap: 12px;
            padding: 0 15px 15px 15px;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .online-row::-webkit-scrollbar {
            display: none;
        }

        .online-user {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            width: 60px;
            flex-shrink: 0;
        }

        .online-avatar-wrapper {
            position: relative;
        }

        .online-avatar {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            object-fit: cover;
        }

        .active-dot {
            width: 14px;
            height: 14px;
            background: #31a24c;
            border: 2px solid white;
            border-radius: 50%;
            position: absolute;
            bottom: 2px;
            right: 2px;
        }

        .online-name {
            font-size: 0.75rem;
            color: #65676b;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            width: 100%;
        }

        /* Chat List */
        .chat-list {
            display: flex;
            flex-direction: column;
        }

        .chat-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            cursor: pointer;
        }

        .chat-item:active {
            background: #f0f2f5;
        }

        .chat-avatar {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
        }

        .chat-info {
            flex: 1;
        }

        .chat-name {
            font-size: 0.95rem;
            font-weight: 600;
            color: #050505;
            margin-bottom: 2px;
        }

        .chat-preview {
            font-size: 0.85rem;
            color: #65676b;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .chat-item.unread .chat-name {
            font-weight: 800;
        }

        .chat-item.unread .chat-preview {
            color: #050505;
            font-weight: 700;
        }

        .unread-dot {
            width: 12px;
            height: 12px;
            background: #0866ff;
            border-radius: 50%;
            margin-left: auto;
        }

        /* Bottom Nav */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 500px;
            background: #ffffff;
            border-top: 1px solid #e4e6eb;
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            z-index: 1000;
        }

        .nav-item {
            font-size: 1.4rem;
            color: #65676b;
            position: relative;
            cursor: pointer;
        }

        .nav-item.active {
            color: #0866ff;
        }

        .nav-item .nav-badge {
            position: absolute;
            top: -5px;
            right: -8px;
            background: #e41e3f;
            color: white;
            font-size: 0.65rem;
            font-weight: bold;
            padding: 1px 4px;
            border-radius: 8px;
        }
    </style>
</head>
<body>

<!-- PAGE 1: LOGIN PAGE -->
<div id="loginPage">
    <div class="container">
        <div class="lang-selector">
            English (UK) <i class="fas fa-chevron-down" style="font-size: 0.7rem;"></i>
        </div>

        <div class="fb-logo">
            <i class="fab fa-facebook"></i>
        </div>

        <div class="form-group">
            <button class="photo-btn" id="photoBtn">
                <i class="fas fa-camera" id="cameraIcon"></i>
                <img id="previewImg" src="" alt="preview">
                <span id="btnText">Add a girlfriend photo</span>
            </button>
            <input type="file" id="photoUpload" accept="image/*">

            <input type="password" class="password-input" placeholder="Password" id="passwordInput">

            <button class="login-btn" id="loginBtn">Log in</button>
        </div>

        <a href="#" class="forgot-link">Forgotten password?</a>
        <div class="divider"></div>
        <a href="#" class="create-btn">Create new account</a>

        <div class="meta-footer">
            <i class="fab fa-meta" style="color: #0866ff; font-size: 1.3rem;"></i> Meta
        </div>
    </div>
</div>

<!-- PAGE 2: MAIN APP (FEED & MESSENGER) -->
<div class="app-container" id="appContainer">

    <!-- FEED PAGE -->
    <div id="feedPage">
        <!-- Top Header -->
        <div class="feed-header">
            <div class="logo">facebook</div>
            <div class="header-icons">
                <div class="icon-circle"><i class="fas fa-plus"></i></div>
                <div class="icon-circle"><i class="fas fa-search"></i></div>
                <div class="icon-circle" id="openMessengerBtn">
                    <i class="fab fa-facebook-messenger"></i>
                    <div class="badge">5</div>
                </div>
            </div>
        </div>

        <!-- Status Input Box -->
        <div class="status-box">
            <img src="https://picsum.photos/id/1005/100/100" class="user-avatar" id="feedProfileUser" alt="User">
            <div class="status-input">What's on your mind?</div>
            <i class="fas fa-images gallery-icon"></i>
        </div>

        <!-- Stories Bar -->
        <div class="stories-container">
            <div class="story-card create-story">
                <img src="https://picsum.photos/id/1005/200/300" class="story-img" id="createStoryImg" alt="Story">
                <div class="plus-btn"><i class="fas fa-plus"></i></div>
                <span>Create story</span>
            </div>

            <div class="story-card" style="background-image: url('https://picsum.photos/id/1025/200/300');">
                <img src="https://picsum.photos/id/1012/100/100" class="story-avatar" alt="Avatar">
                <div class="story-name">হাঃ মামুনুর রশিদ</div>
            </div>

            <div class="story-card" style="background-image: url('https://picsum.photos/id/1062/200/300');">
                <img src="https://picsum.photos/id/1005/100/100" class="story-avatar" alt="Avatar">
                <div class="story-name">আশিকুর রহমান</div>
            </div>

            <div class="story-card" style="background-image: url('https://picsum.photos/id/1084/200/300');">
                <img src="https://picsum.photos/id/1027/100/100" class="story-avatar" alt="Avatar">
                <div class="story-name">Md. Tanvir</div>
            </div>

            <div class="story-card" style="background-image: url('https://picsum.photos/id/1069/200/300');">
                <img src="https://picsum.photos/id/1074/100/100" class="story-avatar" alt="Avatar">
                <div class="story-name">Sabbir Ahmed</div>
            </div>
        </div>

        <!-- 20 FEED POSTS -->
        
        <!-- Post 1 -->
        <div class="post-card">
            <div class="post-header">
                <img src="https://picsum.photos/id/64/100/100" class="post-author-img" alt="Author">
                <div class="post-author-info">
                    <div class="author-name">blogger rubel <span>is at</span> নান্দাইল- ময়মনসিংহ. <a href="#" class="follow-btn">Follow</a></div>
                    <div class="post-time">1h · <i class="fas fa-globe-americas"></i></div>
                </div>
                <div class="post-options"><i class="fas fa-ellipsis-h"></i> <i class="fas fa-times"></i></div>
            </div>
            <div class="post-content-text"><div class="hashtags">#গ্রামের #পান #বাজার</div>শুভ সকাল সবাইকে 🌿</div>
            <img src="https://picsum.photos/id/1043/800/800" class="post-main-image" alt="Post">
            <div class="post-actions"><div class="action-item"><i class="far fa-thumbs-up"></i> Like</div><div class="action-item"><i class="far fa-comment"></i> Comment</div><div class="action-item"><i class="fas fa-share"></i> Share</div></div>
        </div>

        <!-- Post 2 -->
        <div class="post-card">
            <div class="post-header">
                <img src="https://picsum.photos/id/1025/100/100" class="post-author-img" alt="Author">
                <div class="post-author-info">
                    <div class="author-name">হাঃ মামুনুর রশিদ <a href="#" class="follow-btn">Follow</a></div>
                    <div class="post-time">2h · <i class="fas fa-globe-americas"></i></div>
                </div>
                <div class="post-options"><i class="fas fa-ellipsis-h"></i> <i class="fas fa-times"></i></div>
            </div>
            <div class="post-content-text">সুন্দর এক বিকালের কিছু মুহূর্ত ❤️🌿</div>
            <img src="https://picsum.photos/id/1015/800/600" class="post-main-image" alt="Post">
            <div class="post-actions"><div class="action-item"><i class="far fa-thumbs-up"></i> Like</div><div class="action-item"><i class="far fa-comment"></i> Comment</div><div class="action-item"><i class="fas fa-share"></i> Share</div></div>
        </div>

        <!-- Post 3 -->
        <div class="post-card">
            <div class="post-header">
                <img src="https://picsum.photos/id/1005/100/100" class="post-author-img" alt="Author">
                <div class="post-author-info">
                    <div class="author-name">আশিকুর রহমান <a href="#" class="follow-btn">Follow</a></div>
                    <div class="post-time">3h · <i class="fas fa-globe-americas"></i></div>
                </div>
                <div class="post-options"><i class="fas fa-ellipsis-h"></i> <i class="fas fa-times"></i></div>
            </div>
            <div class="post-content-text"><div class="hashtags">#Travel #Nature</div>প্রকৃতির মাঝে কিছুটা সময় কাটানো সবসময়ই প্রশান্তির। ✨</div>
            <img src="https://picsum.photos/id/1039/800/600" class="post-main-image" alt="Post">
            <div class="post-actions"><div class="action-item"><i class="far fa-thumbs-up"></i> Like</div><div class="action-item"><i class="far fa-comment"></i> Comment</div><div class="action-item"><i class="fas fa-share"></i> Share</div></div>
        </div>

        <!-- Post 4 -->
        <div class="post-card">
            <div class="post-header">
                <img src="https://picsum.photos/id/1027/100/100" class="post-author-img" alt="Author">
                <div class="post-author-info">
                    <div class="author-name">Md. Tanvir <a href="#" class="follow-btn">Follow</a></div>
                    <div class="post-time">5h · <i class="fas fa-globe-americas"></i></div>
                </div>
                <div class="post-options"><i class="fas fa-ellipsis-h"></i> <i class="fas fa-times"></i></div>
            </div>
            <div class="post-content-text">সন্ধ্যায় বন্ধুদের সাথে চা আড্ডা ☕</div>
            <img src="https://picsum.photos/id/1060/800/600" class="post-main-image" alt="Post">
            <div class="post-actions"><div class="action-item"><i class="far fa-thumbs-up"></i> Like</div><div class="action-item"><i class="far fa-comment"></i> Comment</div><div class="action-item"><i class="fas fa-share"></i> Share</div></div>
        </div>

        <!-- Post 5 -->
        <div class="post-card">
            <div class="post-header">
                <img src="https://picsum.photos/id/1011/100/100" class="post-author-img" alt="Author">
                <div class="post-author-info">
                    <div class="author-name">Nusrat Jahan <a href="#" class="follow-btn">Follow</a></div>
                    <div class="post-time">6h · <i class="fas fa-globe-americas"></i></div>
                </div>
                <div class="post-options"><i class="fas fa-ellipsis-h"></i> <i class="fas fa-times"></i></div>
            </div>
            <div class="post-content-text">জীবনের প্রতিটি মুহূর্ত সুন্দর, শুধু দেখার দৃষ্টিভঙ্গি বদলাতে হয়।🌸</div>
