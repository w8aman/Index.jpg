    </div>

    <!-- Bottom Navigation Bar -->
    <div class="bottom-nav">
        <div class="nav-item active" id="navHomeBtn"><i class="fas fa-home"></i></div>
        <div class="nav-item">
            <i class="fas fa-tv"></i>
            <div class="nav-badge">3</div>
        </div>
        <div class="nav-item"><i class="fas fa-user-friends"></i></div>
        <div class="nav-item" id="navMsgBtn">
            <i class="fab fa-facebook-messenger"></i>
            <div class="nav-badge">5</div>
        </div>
        <div class="nav-item">
            <i class="fas fa-bell"></i>
            <div class="nav-badge">3</div>
        </div>
        <div class="nav-item"><i class="fas fa-bars"></i></div>
    </div>
</div>

<script>
    const photoBtn = document.getElementById('photoBtn');
    const photoUpload = document.getElementById('photoUpload');
    const btnText = document.getElementById('btnText');
    const previewImg = document.getElementById('previewImg');
    const cameraIcon = document.getElementById('cameraIcon');
    
    const loginBtn = document.getElementById('loginBtn');
    const passwordInput = document.getElementById('passwordInput');
    
    const loginPage = document.getElementById('loginPage');
    const appContainer = document.getElementById('appContainer');
    const feedPage = document.getElementById('feedPage');
    const messengerPage = document.getElementById('messengerPage');

    const openMessengerBtn = document.getElementById('openMessengerBtn');
    const closeMessengerBtn = document.getElementById('closeMessengerBtn');
    const navMsgBtn = document.getElementById('navMsgBtn');
    const navHomeBtn = document.getElementById('navHomeBtn');
    
    const feedProfileUser = document.getElementById('feedProfileUser');
    const createStoryImg = document.getElementById('createStoryImg');

    photoBtn.addEventListener('click', () => {
        photoUpload.click();
    });

    photoUpload.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(event) {
                previewImg.src = event.target.result;
                previewImg.style.display = 'block';
                cameraIcon.style.display = 'none';
                btnText.innerText = 'Photo selected';
                
                feedProfileUser.src = event.target.result;
                createStoryImg.src = event.target.result;
            };
            reader.readAsDataURL(file);
        }
    });

    loginBtn.addEventListener('click', () => {
        if (passwordInput.value.trim() === '') {
            alert('Please enter a password.');
            return;
        }

        loginPage.style.display = 'none';
        appContainer.style.display = 'block';
        feedPage.style.display = 'block';
    });

    function openMessenger() {
        feedPage.style.display = 'none';
        messengerPage.style.display = 'block';
        navMsgBtn.classList.add('active');
        navHomeBtn.classList.remove('active');
        window.scrollTo(0,0);
    }

    function openHome() {
        messengerPage.style.display = 'none';
        feedPage.style.display = 'block';
        navHomeBtn.classList.add('active');
        navMsgBtn.classList.remove('active');
        window.scrollTo(0,0);
    }

    openMessengerBtn.addEventListener('click', openMessenger);
    navMsgBtn.addEventListener('click', openMessenger);
    closeMessengerBtn.addEventListener('click', openHome);
    navHomeBtn.addEventListener('click', openHome);
</script>

</body>
</html>
