                    <div class="chat-name">Sabbir Hossain</div>
                    <div class="chat-preview">You: কিরে কি খবর? · 2d</div>
                </div>
            </div>

            <div class="chat-item">
                <img src="https://picsum.photos/id/1024/100/100" class="chat-avatar" alt="User">
                <div class="chat-info">
                    <div class="chat-name">Farhana Islam</div>
                    <div class="chat-preview">Thanks a lot!! ✨ · 3d</div>
                </div>
            </div>

            <div class="chat-item">
                <img src="https://picsum.photos/id/1001/100/100" class="chat-avatar" alt="User">
                <div class="chat-info">
                    <div class="chat-name">সাকিব হাসান</div>
                    <div class="chat-preview">ম্যাচ দেখতে আসবি? · 4d</div>
                </div>
            </div>

            <div class="chat-item">
                <img src="https://picsum.photos/id/1084/100/100" class="chat-avatar" alt="User">
                <div class="chat-info">
                    <div class="chat-name">Imran Hossain</div>
                    <div class="chat-preview">You: 👋 · 1w</div>
